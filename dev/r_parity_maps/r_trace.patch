+// ---- dada2-rs #277 per-read trace (diagnostic build only) -------------------
+// DADA2RS_TRACE_RAW=<0-based derep index> prints the same TRACE lines as
+// dada2-rs's raw_trace module, at the same points in run_dada, with doubles as
+// raw IEEE-754 bits, so the two logs diff directly.
+#include <cstring>
+#include <cstdint>
+#include <cstdlib>
+static long tr_raw() {
+  const char *s = getenv("DADA2RS_TRACE_RAW");
+  return s ? atol(s) : -1;
+}
+static unsigned long long tr_bits(double x) {
+  uint64_t u; memcpy(&u, &x, sizeof u); return (unsigned long long) u;
+}
+static void tr_bud(B *b, unsigned int i) {
+  if (tr_raw() < 0) return;
+  Bi *bi = b->bi[i];
+  REprintf("TRACE BUD %u from %u centre %d pval %016llx\n", i, bi->birth_from,
+           bi->center ? (int) bi->center->index : -1, tr_bits(bi->birth_pval));
+}
+static void tr_cmp(B *b, unsigned int i) {
+  long t = tr_raw();
+  if (t < 0 || t >= (long) b->nraw) return;
+  Raw *raw = b->raw[t];
+  const Comparison *hit = NULL;
+  for (size_t k = 0; k < b->bi[i]->comp.size(); k++) {
+    if ((long) b->bi[i]->comp[k].index == t) { hit = &b->bi[i]->comp[k]; break; }
+  }
+  if (hit) {
+    REprintf("TRACE CMP %u stored 1 lambda %016llx lock %d emm %016llx\n", i,
+             tr_bits(hit->lambda), (int) raw->lock, tr_bits(raw->E_minmax));
+  } else {
+    REprintf("TRACE CMP %u stored 0 lambda - lock %d emm %016llx\n", i,
+             (int) raw->lock, tr_bits(raw->E_minmax));
+  }
+}
+static void tr_pos(B *b, const char *phase) {
+  long t = tr_raw();
+  if (t < 0 || t >= (long) b->nraw) return;
+  Raw *raw = b->raw[t];
+  long ci = -1;
+  for (unsigned int i = 0; i < b->nclust && ci < 0; i++)
+    for (unsigned int r = 0; r < b->bi[i]->nraw; r++)
+      if (b->bi[i]->raw[r] == raw) { ci = i; break; }
+  REprintf("TRACE POS %s nclust %u in %ld comp.i %u lambda %016llx creads %u lock %d p %016llx\n",
+           phase, b->nclust, ci, raw->comp.i, tr_bits(raw->comp.lambda),
+           ci >= 0 ? b->bi[ci]->reads : 0u, (int) raw->lock, tr_bits(raw->p));
+}
