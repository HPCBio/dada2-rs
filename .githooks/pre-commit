#!/usr/bin/env bash
set -euo pipefail

echo "--- pre-commit: cargo fmt check ---"
if ! cargo fmt --all -- --check; then
    echo ""
    echo "Formatting issues detected. Run 'cargo fmt --all' to fix, then re-stage."
    exit 1
fi

echo "--- pre-commit: cargo clippy (all targets) ---"
# --all-targets covers tests, examples and benches as well as lib+bin. That
# matters twice over:
#
#   * It lints test and example code. Five `field_reassign_with_default`
#     warnings in metrics.rs's tests passed the old lib+bin-only step and only
#     surfaced when --all-targets was run by hand (#174).
#   * It COMPILES the test targets, so adding a field to a struct that a
#     #[cfg(test)] helper constructs is caught here. That used to need its own
#     `cargo test --no-run` step -- it happened when kdist_calibrate::Params
#     gained `derive_cutoff`, and again when b_compare's verbose flag became a
#     ProgressRecord. This subsumes it, so that step is gone.
cargo clippy --all-targets -- -D warnings

echo "--- pre-commit: justfile/Makefile sync ---"
if command -v just >/dev/null 2>&1; then
    ./scripts/check-build-sync.sh
else
    echo "skip: 'just' not installed (CI enforces this check)"
fi
